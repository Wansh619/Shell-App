SHELL_APP_CONFIG_FILE=/etc/shell-app/sys.config
SHELL_APP_RUN_USER=shell-app

SHELL_APP_SMTP_HOST=smtp.gmail.com
SHELL_APP_SMTP_PORT=587
SHELL_APP_SMTP_STARTTLS=true
SHELL_APP_SMTP_SSL=false
SHELL_APP_SMTP_USERNAME=your-gmail-address@gmail.com
SHELL_APP_SMTP_PASSWORD=your-google-app-password
SHELL_APP_SMTP_FROM=your-gmail-address@gmail.com
SHELL_APP_SMTP_TO=recipient@example.com
