SHELL_APP_HOST=0.0.0.0
SHELL_APP_PORT=5000
SHELL_APP_LOG_DIR=/var/lib/shell-app/log
SHELL_APP_SESSION_DB=/var/lib/shell-app/terminal_sessions.db

SHELL_APP_SMTP_HOST=smtp-relay.brevo.com
SHELL_APP_SMTP_PORT=587
SHELL_APP_SMTP_STARTTLS=true
SHELL_APP_SMTP_SSL=false
SHELL_APP_SMTP_USERNAME=your-brevo-smtp-login
SHELL_APP_SMTP_PASSWORD=replace-with-smtp-key
SHELL_APP_SMTP_FROM=verified-sender@example.com
SHELL_APP_SMTP_TO=recipient@example.com
